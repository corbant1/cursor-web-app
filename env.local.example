# M-Files Configuration
# Copy this file to .env.local and fill in your actual values

# Base URL of your M-Files server
# For M-Files Cloud: https://lde-project.cloudvault.m-files.com
# For on-premise: https://your-mfiles-server.com
MFILES_BASE_URL=https://lde-project.cloudvault.m-files.com

# Vault GUID - The GUID of the M-Files vault you want to connect to
# Can be extracted from ClientID in Multi-Server Mode (format: "clientId,vaultGuid")
# For M-Files Cloud Dev Project vault:
MFILES_VAULT_GUID=89A9292B-773C-47D7-9A6D-FD5A945E00EF

# Auth Config Name (optional) - The name of the authentication configuration in M-Files
# Only needed if you have multiple auth configs
MFILES_AUTH_CONFIG_NAME=

# Client Secret - The OAuth client secret configured in M-Files OAuth plugin
# This must match the client secret configured in the M-Files OAuth plugin
MFILES_CLIENT_SECRET=

